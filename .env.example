# Copy this file to .env and fill in your own values.
# Everything prefixed with VITE_ is bundled into the browser build.
# Never put client secrets, connection strings or private API keys here.

# Base URL of the ASP.NET Core Web API (include the /api prefix, no trailing slash)
VITE_API_BASE_URL=https://localhost:7000/api

# Google OAuth 2.0 *Web* client ID (public). The client SECRET belongs on the .NET backend only.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# true  = email login / sign up use a local demo (no backend needed, nothing is saved)
# false = every request goes to VITE_API_BASE_URL
VITE_USE_MOCK_API=true
